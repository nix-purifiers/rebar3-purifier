%% An umbrella project of two applications, server and greeter, with a git
%% dependency at a tag, a git_subdir dependency that brings a Hex
%% dependency of its own, a plugin from git, and a release of both
%% applications.
{erl_opts, [debug_info]}.

{deps, [
    {recon, {git, "https://github.com/ferd/recon.git", {tag, "2.5.6"}}},
    {opentelemetry_api,
        {git_subdir, "https://github.com/open-telemetry/opentelemetry-erlang.git",
            {tag, "opentelemetry_api/v1.5.0"}, "apps/opentelemetry_api"}}
]}.

{plugins, [
    {pc, {git, "https://github.com/blt/port_compiler.git", {tag, "v1.15.0"}}}
]}.

{relx, [
    {release, {umbrella, "1.0.0"}, [server, greeter]},
    {dev_mode, false},
    {include_erts, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod}]}]}
]}.
